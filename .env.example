# mc-admin — configuration d'exemple.
# Copier en `.env` puis adapter. Seules les deux premières valeurs sont
# obligatoires ; le reste a des défauts raisonnables.

# — Obligatoire —————————————————————————————————————————————————————————————
# Clé de signature des sessions (générer : openssl rand -hex 32)
SESSION_SECRET=

# Mot de passe RCON — le MÊME que celui du serveur Minecraft (itzg : RCON_PASSWORD)
RCON_PASSWORD=

# — Chemins hôte ————————————————————————————————————————————————————————————
# Dossier de données du serveur Minecraft (le /data de l'image itzg)
MC_DATA_DIR=/chemin/vers/minecraft/data
# Dossier où écrire les archives de sauvegarde
BACKUPS_DIR=/chemin/vers/backups

# — Réseau ——————————————————————————————————————————————————————————————————
# Réseau docker EXISTANT sur lequel le serveur Minecraft est joignable
# (celui de son docker-compose ; `docker network ls` pour le retrouver)
MC_NETWORK=minecraft_default
# Port HTTP de l'interface mc-admin sur l'hôte
MC_ADMIN_PORT=8080

# — Divers ——————————————————————————————————————————————————————————————————
TZ=Europe/Paris
# Cookies Secure (true si mc-admin est servi en HTTPS — reverse proxy, tailscale serve…)
SESSION_COOKIE_SECURE=false
# CIDR du reverse proxy directement connecté à mc-admin, séparés par des
# virgules. Laisser vide si le port HTTP est accessible directement : les
# en-têtes X-Forwarded-For envoyés par un client seront alors ignorés.
LOGIN_TRUSTED_PROXY_CIDRS=

# — Mise à jour contrôlée (service mc-updater, facultatif) ——————————————————
# Dossier contenant le docker-compose.yml du serveur Minecraft, son nom de
# projet compose et le nom du service à mettre à jour.
MC_COMPOSE_DIR=/chemin/vers/minecraft
MC_COMPOSE_PROJECT=minecraft
MC_SERVICE=minecraft
# Nom du CONTENEUR Minecraft (arrêt/redémarrage pendant une restauration)
MC_CONTAINER=minecraft
# Délai maximal pour que Minecraft redevienne healthy avant rollback
MC_STARTUP_TIMEOUT_SECONDS=300
# Image locale utilisée par mc-admin et ses workers transactionnels
MC_ADMIN_IMAGE=mc-admin:latest

# — Facultatif ——————————————————————————————————————————————————————————————
# Prometheus pour le panneau métriques et la page mise à jour (vide = panneau absent)
PROMETHEUS_URL=
# AMORÇAGE des notifications et de la surveillance : importé UNE FOIS au
# premier démarrage, tout se règle ensuite dans l'UI (page Surveillance).
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_PLAYER_EVENTS=false
HEALTH_ALERTS=false
HEALTH_EXTRA_CONTAINERS=
